{
  "name": "interior-studio-platform",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "description": "Production Architecture for Atelier Vermilion Interior Design Studio Management Platform",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "node ./node_modules/concurrently/dist/bin/concurrently.js --kill-others-on-fail -n \"backend,frontend\" -c \"cyan,magenta\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:frontend": "cd frontend && node ../node_modules/vite/bin/vite.js dev",
    "dev:backend": "cd backend && node ./node_modules/tsx/dist/cli.mjs watch src/server.ts",
    "build": "node ./node_modules/typescript/bin/tsc -p backend/tsconfig.json && cd frontend && node ../node_modules/vite/bin/vite.js build",
    "build:frontend": "cd frontend && node ../node_modules/vite/bin/vite.js build",
    "build:backend": "node ./node_modules/typescript/bin/tsc -p backend/tsconfig.json",
    "seed": "cd backend && node ./node_modules/tsx/dist/cli.mjs src/seed/seed.ts",
    "check": "node ./node_modules/typescript/bin/tsc -p backend/tsconfig.json --noEmit && node ./node_modules/typescript/bin/tsc -p frontend/tsconfig.json --noEmit"
  },
  "dependencies": {
    "express": "^4.21.2",
    "mongodb": "^7.6.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.16.5",
    "concurrently": "^9.1.2",
    "typescript": "^5.8.3",
    "vite": "8.1.5"
  }
}
