# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=interior_studio

# Authentication JWT
JWT_SECRET=super-secret-jwt-key-replace-with-at-least-32-characters
JWT_EXPIRES_IN=7d

# Google Drive (Root Folder ID: 1ix9RDbXHK0JVqsxPyfxYL8M1bCdHdBze)
GOOGLE_DRIVE_ROOT_FOLDER_ID=1ix9RDbXHK0JVqsxPyfxYL8M1bCdHdBze

# Google Service Account (Recommended for Server-to-Server API)
GOOGLE_PROJECT_ID=atelier-vermilion-studio
GOOGLE_CLIENT_EMAIL=interior-studio-service-acc@atelier-vermilion-studio.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Or OAuth2 Refresh Token (Alternative)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
